#!/bin/bash
# merge_v9_metrics.sbatch — concatenate the 96 full-metrics chunk outputs into
# analyses/midrun_v9/collected_clean_metrics.csv.
#
# Replaces the merge generated by full_metrics_parallel.sh, which exited 13 with a 0-byte log
# and produced no output file at all. Differences that matter:
#   - validates every chunk BEFORE writing anything (existence, non-empty, identical header)
#   - writes to a .part file and renames only on success, so a half-merge can never be mistaken
#     for a finished one
#   - NEVER deletes _metrics_chunks; that is a separate decision once the result is verified
#   - reports per-chunk row counts so a truncated chunk is visible instead of silent
#SBATCH --job-name=v9_merge
#SBATCH --partition=normal.4h
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=4G
#SBATCH --output=/cluster/work/wicky/lvalsecchi/rna_binder/analyses/midrun_v9/_v9merge_%j.log
set -uo pipefail                      # NOT -e: we want to report failures, not vanish on them

RB=/cluster/work/wicky/lvalsecchi/rna_binder
V9=$RB/analyses/midrun_v9
CK=$V9/_metrics_chunks
OUT=$V9/collected_clean_metrics.csv
TMP=$OUT.part

cd "$RB" || exit 1
echo "=== v9 metrics merge $(date) on $(hostname) ==="

mapfile -t FILES < <(ls "$CK"/chunk_*_metrics.csv 2>/dev/null | sort)
echo "chunks found: ${#FILES[@]}"
[ "${#FILES[@]}" -gt 0 ] || { echo "FATAL: no chunk metrics files"; exit 1; }

HDR=$(head -1 "${FILES[0]}")
NCOL=$(awk -F, '{print NF; exit}' <<<"$HDR")
echo "header: $NCOL columns, from $(basename "${FILES[0]}")"

# --- validate everything first; a bad chunk must not be discovered halfway through a 3 GB write
bad=0; total=0
for f in "${FILES[@]}"; do
  if [ ! -s "$f" ]; then echo "  EMPTY  $(basename "$f")"; bad=1; continue; fi
  h=$(head -1 "$f")
  if [ "$h" != "$HDR" ]; then
    echo "  HEADER MISMATCH  $(basename "$f")  ($(awk -F, '{print NF; exit}' <<<"$h") cols)"; bad=1; continue
  fi
  n=$(( $(wc -l < "$f") - 1 ))
  total=$(( total + n ))
done
echo "validated ${#FILES[@]} chunks, $total data rows expected"
[ "$bad" -eq 0 ] || { echo "FATAL: chunk validation failed"; exit 2; }

# --- write
rm -f "$TMP"
printf '%s\n' "$HDR" > "$TMP" || { echo "FATAL: cannot write $TMP"; exit 3; }
i=0
for f in "${FILES[@]}"; do
  if ! tail -n +2 "$f" >> "$TMP"; then echo "FATAL: append failed on $f"; exit 4; fi
  i=$((i+1))
  [ $((i % 24)) -eq 0 ] && echo "  ...$i/${#FILES[@]} appended $(date +%H:%M:%S)"
done

got=$(( $(wc -l < "$TMP") - 1 ))
echo "wrote $got data rows (expected $total)"
[ "$got" -eq "$total" ] || { echo "FATAL: row count mismatch"; exit 5; }

clean=$(( $(wc -l < "$V9/collected_clean.csv") - 1 ))
echo "collected_clean.csv has $clean rows"
[ "$got" -eq "$clean" ] || echo "WARNING: metrics rows ($got) != clean rows ($clean)"

mv "$TMP" "$OUT" || { echo "FATAL: rename failed"; exit 6; }
echo "-> $OUT  ($(du -h "$OUT" | cut -f1), $NCOL columns)"
echo "_metrics_chunks kept at $CK — delete once verified"
echo "=== DONE $(date) ==="
