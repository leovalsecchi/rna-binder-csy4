#!/bin/bash
# merge_chunks.sbatch — concatenate per-chunk sidecar CSVs into one file, safely.
#
#   sbatch --export=ALL,MC_GLOB='<dir>/chunk_*_dockq.csv',MC_OUT=<out.csv>[,MC_EXPECT=<rows>] \
#          merge_chunks.sbatch
#
# Replaces the merge generated by full_metrics_parallel.sh / dockq_parallel.sh, which fails
# with ExitCode 13 whenever the chunk count is large enough. Their first line is
#     FIRST=$(ls <glob> | head -1)
# and under `set -euo pipefail` head exits after one line, ls takes SIGPIPE (141 -> reported
# as 13), and `set -e` kills the job before it prints anything. It is a race on the pipe
# buffer, which is why it passed with few chunks and fails at 96/128.
#
# Here: glob into an array (no pipe at all), validate before writing, write to .part and
# rename only on success, and NEVER delete the chunk dir — that deletion is what would have
# destroyed hours of compute had the original failed one line later.
#SBATCH --job-name=merge_chunks
#SBATCH --partition=normal.4h
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=4G
#SBATCH --output=/cluster/work/wicky/lvalsecchi/rna_binder/ops/logs/merge_chunks_%j.log
set -uo pipefail                     # NOT -e: report failures instead of vanishing

: "${MC_GLOB:?set MC_GLOB}"; : "${MC_OUT:?set MC_OUT}"
EXPECT="${MC_EXPECT:-0}"
cd /cluster/work/wicky/lvalsecchi/rna_binder || exit 1
echo "=== merge $(date) on $(hostname) ==="
echo "glob: $MC_GLOB"

shopt -s nullglob
FILES=( $MC_GLOB )                   # glob, not ls|head — see header
echo "chunks found: ${#FILES[@]}"
[ "${#FILES[@]}" -gt 0 ] || { echo "FATAL: glob matched nothing"; exit 1; }

HDR=$(head -1 "${FILES[0]}")
NCOL=$(awk -F, '{print NF; exit}' <<<"$HDR")
echo "header: $NCOL columns from $(basename "${FILES[0]}")"

bad=0; total=0
for f in "${FILES[@]}"; do
  [ -s "$f" ] || { echo "  EMPTY $(basename "$f")"; bad=1; continue; }
  h=$(head -1 "$f")
  [ "$h" = "$HDR" ] || { echo "  HEADER MISMATCH $(basename "$f")"; bad=1; continue; }
  total=$(( total + $(wc -l < "$f") - 1 ))
done
echo "validated ${#FILES[@]} chunks, $total data rows expected"
[ "$bad" -eq 0 ] || { echo "FATAL: validation failed"; exit 2; }

TMP="$MC_OUT.part"; rm -f "$TMP"
printf '%s\n' "$HDR" > "$TMP" || { echo "FATAL: cannot write $TMP"; exit 3; }
i=0
for f in "${FILES[@]}"; do
  tail -n +2 "$f" >> "$TMP" || { echo "FATAL: append failed on $f"; exit 4; }
  i=$((i+1)); [ $((i % 32)) -eq 0 ] && echo "  ...$i/${#FILES[@]} $(date +%H:%M:%S)"
done

got=$(( $(wc -l < "$TMP") - 1 ))
echo "wrote $got rows (expected $total)"
[ "$got" -eq "$total" ] || { echo "FATAL: row mismatch"; exit 5; }
if [ "$EXPECT" -gt 0 ] && [ "$got" -ne "$EXPECT" ]; then
  echo "WARNING: $got rows != MC_EXPECT $EXPECT"
fi

mv "$TMP" "$MC_OUT" || { echo "FATAL: rename failed"; exit 6; }
echo "-> $MC_OUT ($(du -h "$MC_OUT" | cut -f1), $NCOL cols)"
echo "chunk dir kept on purpose — delete once verified"
echo "=== DONE $(date) ==="
