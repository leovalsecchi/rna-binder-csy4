     return structure
 
+def _ca_by_resnum(structure, chains=None):
+    """{residue_number: Cα atom}, for matching the binder across the prediction↔
+    scaffold chain-letter swap. Restricted to `chains` when they carry Cα; else
+    (e.g. the named chain is RNA, which has no Cα) falls back to every Cα-bearing
+    chain — only the protein has Cα, so this still pairs the binder by residue."""
+    def collect(restrict):
+        d = {}
+        for model in structure:
+            for chain in model:
+                if restrict and chain.id not in restrict:
+                    continue
+                for residue in chain:
+                    if 'CA' in residue:
+                        d[residue.id[1]] = residue['CA']
+        return d
+    if chains:
+        d = collect(set(chains))
+        if d:
+            return d
+    return collect(None)
+
