IPTM_VALUES = {"af3": "iptm_af3", "esm": "iptm_esm",
               "min": "iptm_min", "mean": "iptm_mean"}


# --------------------------------------------------------------------------- atoms

def finite(store, name) -> np.ndarray:
    """Cached isfinite when the store offers one; plain isfinite otherwise (test stores)."""
    if hasattr(store, "finite"):
        return store.finite(name)
    return np.isfinite(store.col(name))


def atom_mask(store, atom) -> np.ndarray:
    """Boolean mask for one atom. Non-finite values fail."""
    m = METRICS.get(atom["metric"])
    if m is None:
        raise ValueError(f"unknown metric {atom['metric']!r}")
    op = OPS.get(atom.get("cmp", m.cmp))
    if op is None:
        raise ValueError(f"unknown comparison {atom.get('cmp')!r}")
    name = m.column(atom.get("backend"), atom.get("variant"))
    return op(store.col(name), float(atom["value"])) & finite(store, name)


# A tier with no enabled atoms is NEUTRAL — it does not filter, under AND or OR alike.
# Represented as None rather than an all-True array: materialising one cost a 5.3M-element
# allocation plus a pointless AND on every request, three times over (main + both agreement
# sides). None also makes the OR absorption below explicit instead of implied.
NEUTRAL = None


def _combine(masks, op):
    if not masks:
        return NEUTRAL
    out = masks[0].copy()
    for m in masks[1:]:
        if op == "OR":
            out |= m
        else:
            out &= m
    return out


def combine_two(a, b, op):
    """Combine two possibly-neutral masks. Neutral means 'everything', so it is dropped under
    AND and absorbs under OR."""
    if op == "OR":
        return NEUTRAL if (a is NEUTRAL or b is NEUTRAL) else (a | b)
    if a is NEUTRAL:
        return b
    if b is NEUTRAL:
        return a
    return a & b


def materialize(mask, n):
    return np.ones(n, dtype=bool) if mask is NEUTRAL else mask


def _fold(masks, op):
    """Fold possibly-neutral masks left to right. Empty -> NEUTRAL. Seeded with the first
    element rather than with NEUTRAL, because a NEUTRAL seed means "nothing yet" while a
    NEUTRAL operand means "everything" — folding from one would absorb the whole OR."""
    if not masks:
        return NEUTRAL
    out = masks[0]
    for m in masks[1:]:
        out = combine_two(out, m, op)
    return out


# --------------------------------------------------------------------------- groups

def tier_groups(tier):
    """Normalise a tier to a list of {key, op, atoms}.

    A tier carrying only `atoms` (the shape tier 3 still uses) reads as ONE group under the
    tier's own op, so both shapes evaluate identically and old specs keep working."""
    gs = tier.get("groups")
    if not gs:
        return [{"key": "", "op": tier.get("op", "AND").upper(),
                 "atoms": tier.get("atoms", [])}]
    return [{"key": g.get("key", ""), "op": g.get("op", "AND").upper(),
             "atoms": g.get("atoms", [])} for g in gs]


def tier_atoms(tier):
    """Every atom in a tier, whichever shape it is stored in."""
    return [a for g in tier_groups(tier) for a in g["atoms"]]


def op_for_metric(tier, metric_key):
    """The AND/OR that governs one metric's atoms — which is what a plot's regions must be
    shaded by. With per-metric groups that is the group's own op, not the tier's, so the two
    plots can shade differently."""
    for g in tier_groups(tier):
        if any(a.get("metric") == metric_key for a in g["atoms"]):
            return g["op"]
    return tier.get("op", "AND").upper()


def n_enabled(tier):
    return sum(1 for a in tier_atoms(tier) if a.get("on", True))


def tier_mask(store, tier, force_backend=None):
    """Combine a tier's groups; NEUTRAL if nothing in it constrains. Atoms combine inside a
    group with the group's op, groups combine with the tier's op. force_backend keeps only the
    atoms belonging to that backend (plus backend-free ones), which is how the AF3-vs-ESM
    agreement split is built: it uses the thresholds the user actually set on that side,
    rather than inventing any."""
    out = []
    for g in tier_groups(tier):
        atoms = [a for a in g["atoms"] if a.get("on", True)]
        if force_backend is not None:
            atoms = [a for a in atoms if a.get("backend") in (None, "", force_backend)]
        out.append(_combine([atom_mask(store, a) for a in atoms], g["op"]))
    return _fold(out, tier.get("op", "AND").upper())


# ----------------------------------------------------------------------- ipTM gate

def _top_k_mask(values, candidates, k) -> np.ndarray:
    """Top-k by value among `candidates`. Ties at the cut are broken arbitrarily (argpartition
    ordering), so a filter asking for exactly N gets exactly N."""
    out = np.zeros(values.shape, dtype=bool)
    idx = np.flatnonzero(candidates & np.isfinite(values))
    if idx.size == 0 or k <= 0:
        return out
    if k >= idx.size:
        out[idx] = True
        return out
    out[idx[np.argpartition(values[idx], -k)[-k:]]] = True
    return out


def iptm_mask(store, gate, base, force_backend=None):
    """Apply the ipTM gate to `base` (which may be NEUTRAL). Returns (mask, info)."""
    if not gate or not gate.get("on"):
        return base, {"applied": False}

    value = force_backend or gate.get("value", "min")
    colname = IPTM_VALUES.get(value)
    if colname is None:
        raise ValueError(f"unknown ipTM value {value!r}")
    vals = store.col(colname)
    base = materialize(base, store.n)

    if gate.get("mode", "threshold") == "threshold":
        thr = float(gate.get("threshold", 0.8))
        return base & (vals >= thr) & finite(store, colname), {
            "applied": True, "mode": "threshold", "value": value, "threshold": thr}

    scope = gate.get("scope", "filtered")
    candidates = base if scope == "filtered" else np.ones(store.n, dtype=bool)
    pool = int((candidates & np.isfinite(vals)).sum())
    if gate.get("rank_kind", "n") == "pct":
        pct = float(gate.get("rank_pct", 20.0))
        k = int(math.ceil(pool * pct / 100.0))
    else:
        k = int(gate.get("rank_n", 10000))
    keep = _top_k_mask(vals, candidates, k)
    return base & keep, {"applied": True, "mode": "rank", "value": value, "scope": scope,
                         "k": k, "pool": pool}


# ------------------------------------------------------------------------ evaluate

def evaluate(store, spec, force_backend=None):
    """Full filter tree -> (mask, info). force_backend='af3'|'esm' restricts every
    backend-bearing atom and the ipTM gate to that one backend."""
    tiers = spec.get("tiers", {})
    d1, d3 = tiers.get("t1", {}), tiers.get("t3", {})
    t1 = tier_mask(store, d1, force_backend)
    t3 = tier_mask(store, d3, force_backend)
    base = combine_two(t1, t3, spec.get("combine", "AND").upper())
    mask, ginfo = iptm_mask(store, spec.get("iptm"), base, force_backend)
    # 'anything OR (something empty)' is logically 'everything', which is correct but
    # surprising: you set thresholds, flip an op to OR, and the filter silently stops
    # filtering. It can happen at the top level (tier1 OR empty tier3) and now one level
    # lower too (an empty metric group OR'd inside a tier), so the test is "nothing
    # constrains even though atoms are switched on", not a comparison of the two tiers.
    neutralized = [k for k, d, m in (("t1", d1, t1), ("t3", d3, t3))
                   if m is NEUTRAL and n_enabled(d)]
    unfiltered_or = base is NEUTRAL and (n_enabled(d1) + n_enabled(d3)) > 0
    mask = materialize(mask, store.n)
    cnt = lambda m: store.n if m is NEUTRAL else int(m.sum())      # noqa: E731
    return mask, {"n_tier1": cnt(t1), "n_tier3": cnt(t3),
                  "n_base": cnt(base), "n_pass": int(mask.sum()), "iptm": ginfo,
                  "unfiltered_or": bool(unfiltered_or), "neutralized": neutralized}


def agreement_split(store, spec):
    """How much of the yield depends on which refolder you trust. Evaluates the user's own
    AF3-side thresholds and ESM-side thresholds separately and crosses them."""
    a, _ = evaluate(store, spec, force_backend="af3")
    e, _ = evaluate(store, spec, force_backend="esm")
    return {"both": int((a & e).sum()), "af3_only": int((a & ~e).sum()),
            "esm_only": int((~a & e).sum()), "neither": int((~a & ~e).sum()),
            "af3_total": int(a.sum()), "esm_total": int(e.sum())}


# ------------------------------------------------------------------------- regions

def quadrants(store, metric_key, tx, ty, tier_op, pass_mask=None):
    """The four regions a plot's two thresholds cut it into, counted over the FULL population
    (never the display subsample). `included` marks which regions the tier's AND/OR keeps.

    Designs with a NaN on either axis are unplottable and are reported separately rather than
    being folded into a region."""
    m = METRICS[metric_key]
    nx, ny = m.column("af3"), m.column("esm")
    x, y = store.col(nx), store.col(ny)
    op = OPS[m.cmp]
    ok = finite(store, nx) & finite(store, ny)
    px, py = op(x, float(tx)) & ok, op(y, float(ty)) & ok

    # inclusion-exclusion off three reductions, rather than building four region arrays and
    # reducing each: the four counts are determined by |px|, |py|, |px∩py| and |ok|
    n_ok, n_px, n_py = int(ok.sum()), int(px.sum()), int(py.sum())
    n_both = int((px & py).sum())
    counts = {"both": n_both, "af3_only": n_px - n_both, "esm_only": n_py - n_both,
              "neither": n_ok - n_px - n_py + n_both}

    passing = {k: None for k in counts}
    if pass_mask is not None:
        # the passing set is tiny next to the store, so slice down to it first and do the
        # region arithmetic on a few thousand elements instead of a few million
        i = np.flatnonzero(pass_mask)
        a, b, o = px[i], py[i], ok[i]
        p_ok, p_a, p_b = int(o.sum()), int(a.sum()), int(b.sum())
        p_both = int((a & b).sum())
        passing = {"both": p_both, "af3_only": p_a - p_both, "esm_only": p_b - p_both,
                   "neither": p_ok - p_a - p_b + p_both}

    keep = {"both"} if tier_op.upper() == "AND" else {"both", "af3_only", "esm_only"}
    out = {k: {"n": c, "pct": 100.0 * c / store.n, "included": k in keep,
               "n_passing": passing[k]} for k, c in counts.items()}
    n_nan = store.n - n_ok
    out["_nan"] = {"n": n_nan, "pct": 100.0 * n_nan / store.n}
    return out
