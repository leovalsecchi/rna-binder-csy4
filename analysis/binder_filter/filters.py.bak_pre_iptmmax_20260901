"""filters.py — the filter-tree evaluator.

A filter atom is (metric, backend, cmp, value). Atoms live in GROUPS, groups live in tiers:

    atoms --(group op)--> group --(tier op)--> tier --(top-level op)--> ipTM gate

The group level exists because one op per tier is too coarse. Tier 1 puts each metric in its
own group, so sc_RMSD can be "af3 AND esm" while sc_DockQ is "af3 OR esm" — two independent
questions that a single tier-wide op could not express.

Three rules that are easy to get wrong and expensive to get wrong:

1. **NaN fails closed.** A design with a missing value FAILS any filter on that metric. It is
   never silently passed. (A filter key that silently no-ops has bitten this project before:
   in metric_explorer a bad constraint key was skipped, so every design "passed".)

2. **An empty group or tier does not filter.** With no enabled atoms it is neutral (all True)
   under both AND and OR — not the empty-OR identity of all False, which would zero the result
   the moment you unticked the last box.

3. **Neutral ABSORBS under OR**, at every level. "no constraint OR anything" is no constraint,
   so an empty group inside an OR neutralises its whole tier. That is correct but reads as a
   broken filter, so `evaluate` reports it rather than just returning the full campaign.

Boltz-2 cannot be referenced: the store has no b2 column and METRICS lists no b2 backend.
"""
from __future__ import annotations

import math

import numpy as np

BACKENDS = ("af3", "esm")
OPS = {
    "<=": lambda a, v: a <= v,
    ">=": lambda a, v: a >= v,
    "<": lambda a, v: a < v,
    ">": lambda a, v: a > v,
}


class Metric:
    """`variants` turns one metric into a FAMILY of columns sharing a filter row.

    `footn` uses it: the atom-count-inside-the-foot is a different column per distance, but it
    is ONE question ("how much of the binder is inside the scaffold volume?") with a distance
    knob, not eleven unrelated metrics. Column becomes `<key>_<variant>_<backend>`.
    An unknown variant RAISES — a silently-ignored variant would filter on the wrong distance,
    which is exactly the silent-no-op failure this module is built to prevent."""

    def __init__(self, key, label, unit, backends, better, tier, default, cmp,
                 variants=(), variant_default=None, variant_unit=""):
        self.key, self.label, self.unit = key, label, unit
        self.backends, self.better = backends, better
        self.tier, self.default, self.cmp = tier, default, cmp
        self.variants = tuple(variants)
        self.variant_default = variant_default or (self.variants[0][0] if self.variants
                                                   else None)
        self.variant_unit = variant_unit

    def column(self, backend=None, variant=None):
        if self.variants:
            # None means "caller did not specify" -> default. An explicit "" (or any other
            # unknown value) is a BUG and must raise, not quietly gate on the wrong distance.
            variant = self.variant_default if variant is None else variant
            if variant not in {v for v, _ in self.variants}:
                raise ValueError(f"metric {self.key} has no variant {variant!r}")
            stem = f"{self.key}_{variant}"
        else:
            if variant is not None:
                raise ValueError(f"metric {self.key} takes no variant")
            stem = self.key
        if not self.backends:
            return stem
        if backend not in self.backends:
            raise ValueError(f"metric {self.key} has no backend {backend!r}")
        return f"{stem}_{backend}"

    def as_dict(self):
        return {"key": self.key, "label": self.label, "unit": self.unit,
                "backends": list(self.backends), "better": self.better,
                "tier": self.tier, "default": self.default, "cmp": self.cmp,
                "variants": [{"key": v, "label": lab} for v, lab in self.variants],
                "variant_default": self.variant_default,
                "variant_unit": self.variant_unit}


