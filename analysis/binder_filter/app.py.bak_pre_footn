# ------------------------------------------------------------- ChimeraX (proxied)

@app.route("/api/open", methods=["POST"])
def api_open():
    """Open one design, or a set to cycle through, in ChimeraX. Proxied server-side so the
    browser only ever talks to this app — no cross-origin request, no CORS to configure."""
    req = request.get_json(force=True) or {}
    s = store()
    rows = req.get("rows") or ([req["row"]] if "row" in req else [])
    rows = [int(i) for i in rows if 0 <= int(i) < s.n]
    if not rows:
        return jsonify({"ok": False, "error": "no rows"}), 400
    designs = []
    for i in rows:
        p = s.paths(i)
        designs.append({"id": s.col("design_id")[i].decode(),
                        "design": p["designed_cif_path"],
                        "af3": p["af3_msaoff_cif_path"],
                        "esm": p["esm_cif_path"]})
    payload = {"designs": designs, "label": req.get("label", "")}
    if REMOTE:
        # this process cannot reach the viewer's ChimeraX; hand the payload back so the page
        # can post it to the bridge running on the machine the browser is on
        return jsonify({"ok": True, "n": len(designs), "delegate": True, "payload": payload})
    try:
        r = urllib.request.urlopen(
            urllib.request.Request(f"{BRIDGE}/openset", data=json.dumps(payload).encode(),
                                   headers={"Content-Type": "application/json"}),
            timeout=300)
        return jsonify({"ok": True, "n": len(designs), "bridge": r.read().decode()[:2000]})
    except urllib.error.URLError as e:
        return jsonify({"ok": False, "n": len(designs), "delegate": True, "payload": payload,
                        "error": f"bridge unreachable at {BRIDGE} ({e}). "
                                 f"Start it with: openrefolds"}), 502


@app.route("/static/plotly.min.js")
def plotly_js():
    """Served from the installed plotly package so the tool works with no network."""
    import plotly
    return send_file(os.path.join(os.path.dirname(plotly.__file__),
                                  "package_data", "plotly.min.js"),
                     mimetype="application/javascript")


def warmup():
    """Pay the lazy costs before anyone clicks. The first filter request otherwise computes
    every finite-mask and baseline histogram from cold — 14 s on a freshly started Euler node,
    which reads as a broken tool rather than a warming cache."""
    s = store()
    t0 = time.time()
    groups = [{"key": m, "op": "AND",
               "atoms": [{"metric": m, "backend": b, "cmp": F.METRICS[m].cmp,
                          "value": F.METRICS[m].default, "on": True}
                         for b in ("af3", "esm")]}
              for m in ("rmsd", "dockq")]
    spec = {"tiers": {"t1": {"op": "AND", "groups": groups}}, "combine": "AND",
            "iptm": {"on": False}}
    mask, _ = F.evaluate(s, spec)
    F.agreement_split(s, spec)
    for mk in ("rmsd", "dockq"):
        F.quadrants(s, mk, F.METRICS[mk].default, F.METRICS[mk].default, "AND", pass_mask=mask)
    for f in ["length"] + s.numeric_cols():
        _baseline(s, f)
    for f in CATEGORICAL:
        _CAT_BASE[f] = np.bincount(s.col(f), minlength=len(s.vocabs.get(f, [])))
    subsample(DEFAULT_SUB, None)
    print(f"warmed caches in {time.time()-t0:.1f}s", flush=True)


if __name__ == "__main__":
    load_store()
    if STORE is not None:
        warmup()
    print(f"binder_filter on http://{HOST}:{PORT}"
          f"{'  (remote mode: ChimeraX handled browser-side)' if REMOTE else ''}", flush=True)
    app.run(host=HOST, port=PORT, debug=False, threaded=True)
