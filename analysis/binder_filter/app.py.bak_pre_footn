@app.route("/api/export/csv", methods=["POST"])
def api_export_csv():
    req = request.get_json(force=True) or {}
    s = store()
    mask, _ = F.evaluate(s, req.get("spec") or {})
    n = int(mask.sum())
    if n > EX.CSV_CONFIRM_CAP and not req.get("confirm"):
        return jsonify({"ok": False, "need_confirm": True, "count": n})
    try:
        return jsonify({"ok": True, **EX.export_csv(s, mask, req.get("spec") or {},
                                                    req.get("name") or "passing")})
    except ValueError as e:
        return jsonify({"ok": False, "error": str(e)}), 400


@app.route("/api/export/cifs", methods=["POST"])
def api_export_cifs():
    req = request.get_json(force=True) or {}
    s = store()
    mask, _ = F.evaluate(s, req.get("spec") or {})
    idx = np.flatnonzero(mask)
    if idx.size > EX.CIF_CONFIRM_CAP and not req.get("confirm"):
        return jsonify({"ok": False, "need_confirm": True, "count": int(idx.size)})
    designs = [{"design_id": s.col("design_id")[i].decode(),
                "refs": {k: v for k, v in zip(("design", "af3", "esm"),
                                              (s.paths(int(i))["designed_cif_path"],
                                               s.paths(int(i))["af3_msaoff_cif_path"],
                                               s.paths(int(i))["esm_cif_path"]))}}
               for i in idx.tolist()]
    try:
        return jsonify({"ok": True, "job": EX.start_cifs(designs,
                                                         req.get("name") or "passing")})
    except (ValueError, RuntimeError) as e:
        return jsonify({"ok": False, "error": str(e)}), 400


