#!/usr/bin/env python3
"""app.py — interactive filter bench for the Csy4 binder campaign.

    ~/miniconda3/bin/python ~/Documents/binder_filter/app.py     ->  http://127.0.0.1:8010

Two scatter plots (sc_RMSD af3-vs-esm, sc_DockQ af3-vs-esm) over the whole campaign, a
grouped AND/OR filter tree, and a breakdown of what survives versus the campaign baseline.

**Every count and percentage is computed over the full store, never over the display
subsample.** The subsample exists only so the browser can draw something; quoting a statistic
from it while showing the full n is a bug this project has already shipped once.

Boltz-2 is absent by construction: the store carries no b2 column.
"""
from __future__ import annotations

import os
import time

import json
import urllib.error
import urllib.request

import numpy as np
from flask import Flask, jsonify, render_template, request, send_file

import export as EX
import filters as F
from store import Store

app = Flask(__name__)

PORT = int(os.environ.get("BF_PORT", "8010"))
HOST = os.environ.get("BF_HOST", "127.0.0.1")
BRIDGE = "http://127.0.0.1:45001"      # open_refolds_server.py; proxied so the page never
                                       # makes a cross-origin request and CORS never applies
# On a remote deployment (Euler + ssh tunnel) the browser is on the viewer's own machine, so
# the bridge is reachable from the BROWSER but never from this process. The page is told to
# fall back to calling it directly in that case.
REMOTE = os.environ.get("BF_REMOTE", "").strip() not in ("", "0", "false", "no")
DEFAULT_SUB = 50_000
CATEGORICAL = ("stack", "campaign", "gen", "invfold")
NUM_BINS = 40
UUID_CONC_CAP = 500_000

STORE: Store | None = None
STORE_ERR = ""
_SUB: dict = {}                     # (size, stratify) -> row indices, cached


def store() -> Store:
    if STORE is None:
        raise RuntimeError(STORE_ERR or "store not loaded")
    return STORE


def load_store():
    global STORE, STORE_ERR
    t0 = time.time()
    try:
        STORE = Store()
        print(f"loaded store: {STORE.n:,} designs, {len(STORE.templates)} path templates, "
              f"{time.time()-t0:.1f}s", flush=True)
        for c in ("rog_af3", "rog_esm"):
            if not STORE.has_data(c):
                print(f"  note: {c} is all-NaN (placeholder) — that filter will be disabled",
                      flush=True)
    except Exception as e:                                    # noqa: BLE001
        STORE_ERR = f"{type(e).__name__}: {e}"
        print(f"STORE NOT LOADED: {STORE_ERR}", flush=True)


def subsample(size: int, stratify: str | None):
    key = (int(size), stratify or "")
    if key not in _SUB:
        _SUB[key] = store().subsample(size, stratify=stratify)
    return _SUB[key]


