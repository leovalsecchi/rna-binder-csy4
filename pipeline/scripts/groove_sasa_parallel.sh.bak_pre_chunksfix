#!/bin/bash
# groove_sasa_parallel.sh — SASA-ONLY sibling of interface_be_parallel.sh. Fills the
# Biotite dSASA + RNA moiety/groove decomposition (dsasa_rna_*, frac_dsasa_*) onto a slim
# per-backend manifest, sharded across a SLURM array, then merges to groove_<be>.csv.
#
# Deliberately does NOT run interface_rosetta.py: this pass only needs the per-atom Biotite
# SASA, and Rosetta is what makes the full interface array expensive (~990 s/chunk median).
#
#   bash groove_sasa_parallel.sh <groove_manifest_<be>.csv> <path_col> <be_tag> [N=96]
#
# Directives copied from interface_be_parallel.sh (known-good): normal.4h, 8 cpus,
# --mem-per-cpu=3G, --tmp=680000 + ARCH_READ_CACHE_MAX=3 (node-local /local extract-cache
# guard), --requeue.
set -euo pipefail
RB=/cluster/work/wicky/lvalsecchi/rna_binder
cd "$RB"
MAN="${1:?usage: groove_sasa_parallel.sh <manifest.csv> <path_col> <be_tag> [N]}"
COL="${2:?need path-col name}"
BE="${3:?need backend tag}"
N="${4:-96}"
THROTTLE="${THROTTLE:-64}"
CK="${MAN%.csv}_${BE}_chunks"
[ -f "$MAN" ] || { echo "FATAL: no $MAN"; exit 1; }

rm -rf "$CK"; mkdir -p "$CK/logs"
python3 - "$MAN" "$CK" "$N" <<'PY'
import sys, math, pandas as pd
inp, ck, N = sys.argv[1], sys.argv[2], int(sys.argv[3])
df = pd.read_csv(inp, low_memory=False)
per = math.ceil(len(df) / N)
for i in range(N):
    df.iloc[i*per:(i+1)*per].to_csv(f"{ck}/chunk_{i:03d}.csv", index=False)
print(f"{len(df):,} rows -> {N} chunks (~{per} each)")
PY

cat > "$CK/_compute.sbatch" <<EOF
#!/bin/bash
#SBATCH --job-name=groove_${BE}
#SBATCH --partition=normal.4h
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=3G
#SBATCH --tmp=680000
#SBATCH --requeue
#SBATCH --output=$CK/logs/%A_%a.log
set -uo pipefail
cd $RB
export ARCH_READ_CACHE_MAX=3          # bound node-local .tar.zst extract cache (/local leak fix)
IDX=\$(printf "%03d" "\$SLURM_ARRAY_TASK_ID")
IN="$CK/chunk_\${IDX}.csv"
[ -s "\$IN" ] || { echo "empty \$IN"; exit 0; }
J="\${SLURM_CPUS_PER_TASK:-8}"
echo "task \$IDX tmpdir=\${TMPDIR:-UNSET} ($BE) on \$(hostname) \$(date)"
apptainer exec --bind /cluster/work/wicky --bind /tmp --env MPLCONFIGDIR=/tmp \\
  /cluster/work/wicky/containers/boltzgen.sif \\
  env PYTHONPATH=code/src:code/scripts python3 \\
  code/scripts/contacts_sidecar.py --csv "\$IN" --path-col "$COL" --sasa --jobs "\$J" --progress
RC=\$?
# The trailing echo would otherwise mask a sidecar crash: with 'set -uo pipefail' (no -e)
# the script's exit status is the LAST command's, so a failed chunk would still satisfy
# --dependency=afterok and get concatenated by the merge with a 2-column header.
[ \$RC -eq 0 ] || { echo "FATAL chunk \$IDX: sidecar exited \$RC"; exit 1; }
head -1 "\$IN" | grep -q "dsasa_rna_base_major" || {
  echo "FATAL chunk \$IDX: groove columns missing after sidecar"; exit 1; }
echo "chunk \$IDX DONE \$(date)"
EOF

cat > "$CK/_merge.sbatch" <<EOF
#!/bin/bash
#SBATCH --job-name=groove_${BE}_merge
#SBATCH --partition=normal.4h
#SBATCH --time=00:20:00
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=6G
#SBATCH --output=$CK/_merge_%j.log
set -euo pipefail
cd $RB
OUT="$CK/groove_${BE}.csv"
# bash globs expand PRE-SORTED; `ls|sort|head -1` races on SIGPIPE under
# `set -o pipefail` (head closes the pipe, sort dies, -e kills the script)
CHUNKS=( $CK/chunk_*.csv )
FIRST="${CHUNKS[0]}"
# Guard: a chunk whose sidecar failed keeps the slim 2-column header. Concatenating it
# would silently misalign every row, so verify all headers are identical FIRST.
REF=\$(head -1 "\$FIRST")
NCH=0
for f in "${CHUNKS[@]}"; do
  [ "\$(head -1 "\$f")" = "\$REF" ] || { echo "FATAL: header mismatch in \$f"; exit 1; }
  NCH=\$((NCH+1))
done
echo "\$NCH chunks, headers consistent (\$(echo "\$REF" | tr ',' '\\n' | wc -l) cols)"
echo "\$REF" > "\$OUT"
for f in "${CHUNKS[@]}"; do tail -n +2 "\$f" >> "\$OUT"; done
echo "merged -> \$OUT (\$(( \$(wc -l < "\$OUT") - 1 )) rows)"
python3 - "\$OUT" <<'PYX'
import csv, sys
csv.field_size_limit(10**7)
rows = list(csv.DictReader(open(sys.argv[1])))
for c in ["dsasa_total_biotite","dsasa_rna_total","dsasa_rna_base",
          "dsasa_rna_base_major","frac_dsasa_base"]:
    n = sum(1 for r in rows if str(r.get(c,"")).strip() not in ("","nan"))
    print(f"  {c:24s} {n}/{len(rows)}")
PYX
EOF

ARR=$(sbatch --parsable --array=0-$((N-1))%${THROTTLE} "$CK/_compute.sbatch")
echo "compute array ($BE): $ARR (0-$((N-1))%${THROTTLE})"
MRG=$(sbatch --parsable --dependency=afterok:"$ARR" "$CK/_merge.sbatch")
echo "merge ($BE): $MRG (afterok:$ARR)"
